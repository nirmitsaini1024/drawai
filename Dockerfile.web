# syntax=docker/dockerfile:1.7
# Frontend: Vite build served by nginx (prod) or the Vite dev server (target "dev").

# ---- deps -------------------------------------------------------------------
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# ---- dev (docker-compose.dev.yml) -------------------------------------------
FROM deps AS dev
ENV NODE_ENV=development
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# ---- build ------------------------------------------------------------------
FROM deps AS build
# Empty values mean "same origin": nginx proxies /api and /connect to the services.
ARG VITE_API_BASE_URL=""
ARG VITE_SYNC_WS_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_SYNC_WS_URL=$VITE_SYNC_WS_URL
COPY . .
RUN npm run build

# ---- runtime (non-root nginx on :8080) --------------------------------------
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
