# Local (non-Docker) API settings. Copy to server/.env (git-ignored).
# Docker Compose ignores this file and builds DATABASE_URL from root .env POSTGRES_*.

OPENROUTER_API_KEY=sk-or-REPLACE_ME
MODEL=deepseek/deepseek-v4.1-flash-1017

# Async SQLAlchemy URL (asyncpg driver). Match your local Postgres.
# Docker form (for reference only): postgresql+asyncpg://drawai:PASSWORD@postgres:5432/drawai
DATABASE_URL=postgresql+asyncpg://drawai:CHANGE_ME@localhost:5432/drawai

# Comma-separated origins that may call the API from the browser.
WEB_ORIGIN=http://localhost:5173

# Optional OpenRouter attribution headers
# OPENROUTER_HTTP_REFERER=http://localhost:5173
# OPENROUTER_APP_TITLE=DrawAI

# AI guardrails (see root .env.example for descriptions)
RATE_LIMIT_PER_MINUTE=5
DAILY_LIMIT=100
MAX_CONCURRENT_PER_CLIENT=1
GLOBAL_RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY=0
# REDIS_URL=
MAX_PROMPT_CHARS=800
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
CLIENT_HASH_SALT=drawai-guardrails
# ADMIN_TOKEN=

# AI failure / request log file (rotating). Default: server/logs/ai.log
# LOG_DIR=logs
# LOG_FILE=ai.log
# LOG_MAX_BYTES=5242880
# LOG_BACKUP_COUNT=5
