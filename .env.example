# DrawAI environment. Copy to `.env` (git-ignored) and fill in the placeholders.
# Docker Compose reads this file. Local `npm run dev` also uses `server/.env`
# (see server/.env.example) plus the VITE_* vars below if you export them.

# ---- Postgres (Docker Compose builds DATABASE_URL from these) ----------------
POSTGRES_USER=drawai
POSTGRES_DB=drawai
# Letters/digits only: embedded in connection URLs. e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=change-me-use-a-long-random-value

# Full URL is normally set automatically inside Compose:
#   API:  postgresql+asyncpg://USER:PASSWORD@postgres:5432/DB
#   Sync: postgresql://USER:PASSWORD@postgres:5432/DB
# For a non-Docker local Postgres, put DATABASE_URL in server/.env instead, e.g.:
#   DATABASE_URL=postgresql+asyncpg://drawai:PASSWORD@localhost:5432/drawai

# ---- API (FastAPI) ------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-REPLACE_ME
# ANTHROPIC_API_KEY=   # accepted as a fallback name for the same key
MODEL=deepseek/deepseek-v4.1-flash-1017
# Browser origin(s) allowed to call the API (comma-separated).
WEB_ORIGIN=http://localhost:8080

# ---- Web container ------------------------------------------------------------
WEB_PORT=8080
# Bound to localhost because there is no authentication.
# Only set 0.0.0.0 behind a login proxy / VPN.
WEB_BIND=127.0.0.1

# ---- Frontend, local dev (npm run dev) ----------------------------------------
# Unset = built-in localhost defaults. Empty string = same origin (Docker web).
VITE_API_BASE_URL=http://localhost:8000
VITE_SYNC_WS_URL=ws://localhost:8787/connect
